{
  "name": "billflow-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E suite for BillFlow (freelancer-invoices) — isolated stack on its own database",
  "scripts": {
    "test": "playwright test",
    "test:utc": "TZ=UTC playwright test",
    "typecheck": "tsc --noEmit",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
