# ---------------------------------------------------------------------------
# freelancer-invoices · environment for `docker compose` (docker-compose.yml)
#   cp .env.example .env   # then edit
#
# TrueNAS Custom Apps do NOT read this file — for the NAS, edit the values
# directly in docker-compose.registry.yml when pasting it (see deploy/AUTOMATION.md).
# ---------------------------------------------------------------------------

# === Database (internal only — never published) ===
POSTGRES_USER=freelancer
# Use a strong, URL-safe password (letters, digits, - and _): it is embedded
# in the backend's DATABASE_URL.
POSTGRES_PASSWORD=freelancer
POSTGRES_DB=freelancer_invoices

# === Published port ===
# Only the frontend is exposed; it proxies /api to the backend internally.
APP_PORT=3000

# === Images (used when pulling instead of building) ===
IMAGE_PREFIX=ghcr.io/aceswolf1
IMAGE_TAG=latest

# === Timezone ===
# IANA timezone of the user; drives "today" and week boundaries. Containers
# default to UTC, so without this the current week flips early in the evening
# for anyone west of Greenwich.
TZ=America/Chicago

# === Backend ===
RUN_MIGRATIONS=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
