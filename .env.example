# ---------------------------------------------------------------------------
# freelancer-invoices · environment template
#   cp .env.example .env   — .env is git-ignored; never commit it.
#
# Compose reads .env automatically from the repository root. Variables that
# apply only to local (non-Docker) development are grouped at the bottom and are
# IGNORED by docker compose.
# ---------------------------------------------------------------------------

# === Database (Compose) =====================================================
# Superuser + database created by the postgres image on first boot.
# NOTE: keep POSTGRES_PASSWORD URL-safe (letters, digits, . _ - ). It is
# interpolated straight into DATABASE_URL below, so @ : / # would break the URL.
POSTGRES_USER=freelancer
POSTGRES_PASSWORD=freelancer
POSTGRES_DB=freelancer_invoices

# Host port published for the database. 5433 (not 5432) so a local Postgres 18
# dev server on 5432 can run at the same time. Set DB_PORT=5432 to bind directly.
DB_PORT=5433

# === Published host ports ===================================================
# The API is published on 4400, not 4000: `Local.app` owns 127.0.0.1:4000 on this
# machine. Set BACKEND_PORT to move it, but keep NUXT_PUBLIC_API_BASE in sync —
# the browser, not the container, resolves it.
BACKEND_PORT=4400
FRONTEND_PORT=3000

# === Timezone ===============================================================
# IANA timezone of the user; drives "today" and week boundaries. Containers
# default to UTC, so without this the current week flips early in the evening
# for anyone west of Greenwich. Example: America/Chicago, Europe/Berlin.
TZ=America/Chicago

# === Backend API ============================================================
# CORS_ORIGIN is the browser origin of the UI. Change it if you serve the UI on
# a different host/port (e.g. http://truenas.local:3000).
CORS_ORIGIN=http://localhost:3000

# Run pending Drizzle migrations before starting the server (recommended: keep
# true — a single backend container owns schema changes). Set false only if you
# migrate from outside the container.
RUN_MIGRATIONS=true

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# === Frontend (Nuxt) =========================================================
# Browser-reachable API base, including the /api prefix. NOT resolvable through
# Docker DNS — the browser is outside the Compose network.
#   Laptop / direct IP : http://localhost:4400/api
#   TrueNAS by hostname : http://truenas.local:4400/api
NUXT_PUBLIC_API_BASE=http://localhost:4400/api

# Container-internal listen port (mapped to FRONTEND_PORT on the host).
NUXT_PORT=3000

# === Local development only (ignored by docker compose) =====================
# Used when you run the apps with `npm run dev` against a Postgres you run
# yourself (local Postgres 18: user `cace`, no password).
# DATABASE_URL=postgres://cace@localhost:5432/freelancer_invoices
# DATABASE_URL_TEST=postgres://cace@localhost:5432/freelancer_invoices_test
# PORT=4400