# Frontend environment (copy to .env)
# Base URL of the backend API, including the /api prefix.
# Local dev backend runs on :4400 (127.0.0.1:4000 is taken by Local.app).
# Docker: http://backend:4000/api
NUXT_PUBLIC_API_BASE=http://localhost:4400/api

# Port the Nuxt dev/prod server listens on.
NUXT_PORT=3000
PORT=3000