# Backend environment — copy to .env and adjust.
# Local dev: node-postgres on localhost:5432, user "cace", no password.
DATABASE_URL=postgres://cace@localhost:5432/freelancer_invoices
# Test database used by `npm test` (Supertest integration specs).
DATABASE_URL_TEST=postgres://cace@localhost:5432/freelancer_invoices_test
PORT=4400
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info